# ============================================================
# Stellar AI ChainOracle - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/chainoracle"

# --- AI Provider (OpenAI-compatible) ---
# Swap this for any OpenAI-compatible provider (Groq, Together, Ollama, etc.)
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# --- Stellar Network ---
# Options: "mainnet" | "testnet" | "futurenet"
STELLAR_NETWORK="testnet"
# Override Horizon URL (optional — defaults to public Horizon)
# STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Stellar AI ChainOracle"

# --- Rate Limiting (optional) ---
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
